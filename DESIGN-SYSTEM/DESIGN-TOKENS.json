      "white": "#FFFFFF",
      "mint-dark": "#98D5A4",
      "mint-light": "#2C6A35",
      "warn-dark": "#FFD18A",
      "warn-light": "#8B5200",
      "danger-dark": "#FFA59A",
      "danger-light": "#B42318"
