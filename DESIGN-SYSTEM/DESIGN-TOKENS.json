{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "name": "1MS Studio Design System — Muse for Windows",
    "standard": "1RS v1.2",
    "version": "1.0.0",
    "brandAccent": "#FAFF69",
    "brandFont": "Play",
    "iconSystem": "Lucide Icons"
  },
  "primitive": {
    "color": {
      "lime-400": "#FAFF69",
      "lime-500": "#E5EC4B",
      "lime-600": "#C7CE32",
      "lime-700": "#9EA51C",
      "lime-ink": "#101208",
      "carbon-950": "#0B0D10",
      "carbon-900": "#12151A",
      "carbon-850": "#1B1F26",
      "carbon-800": "#20242B",
      "carbon-700": "#282D36",
      "carbon-600": "#363D49",
      "slate-50": "#F5F7FA",
      "slate-100": "#F5F6F8",
      "slate-150": "#EAEDF1",
      "slate-200": "#DDE1E6",
      "slate-400": "#949BA8",
      "slate-500": "#727986",
      "slate-600": "#555D68",
      "slate-900": "#15171C",
      "white": "#FFFFFF",
      "emerald-400": "#34D399",
      "emerald-600": "#059669",
      "amber-400": "#FBBF24",
      "amber-600": "#D97706",
      "rose-400": "#F87171",
      "rose-600": "#DC2626",
      "blue-400": "#60A5FA",
      "blue-600": "#2563EB"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px"
    },
    "radius": {
      "xs": "4px",
      "sm": "6px",
      "md": "8px",
      "lg": "10px",
      "xl": "12px",
      "pill": "9999px"
    },
    "typography": {
      "fontFamily": {
        "brand": "'Play', 'Segoe UI', system-ui, -apple-system, sans-serif",
        "mono": "'Cascadia Mono', 'Consolas', ui-monospace, monospace"
      },
      "fontSize": {
        "xs": "11px",
        "sm": "12px",
        "compact": "13px",
        "base": "14px",
        "md": "16px",
        "lg": "20px",
        "xl": "24px",
        "2xl": "28px"
      },
      "lineHeight": {
        "heading": "1.28",
        "compact": "1.38",
        "body": "1.5"
      }
    },
    "motion": {
      "duration": {
        "instant": "80ms",
        "fast": "120ms",
        "normal": "180ms",
        "moderate": "220ms",
        "slow": "280ms"
      },
      "easing": {
        "outQuint": "cubic-bezier(0.23, 1, 0.32, 1)",
        "outCubic": "cubic-bezier(0.33, 1, 0.68, 1)",
        "inOutCubic": "cubic-bezier(0.645, 0.045, 0.355, 1)",
        "spring": "cubic-bezier(0.34, 1.36, 0.64, 1)"
      }
    }
  },
  "semantic": {
    "dark": {
      "background": "#0B0D10",
      "surface": "#12151A",
      "surfaceElevated": "#1B1F26",
      "surfaceHover": "#20242B",
      "border": "#282D36",
      "borderSubtle": "#1E232B",
      "textPrimary": "#F5F7FA",
      "textSecondary": "#949BA8",
      "textMuted": "#858D9C",
      "accent": "#FAFF69",
      "accentHover": "#E5EC4B",
      "accentSubtle": "rgba(250, 255, 105, 0.12)",
      "accentForeground": "#101208",
      "success": "#34D399",
      "warning": "#FBBF24",
      "danger": "#F87171",
      "info": "#60A5FA"
    },
    "light": {
      "background": "#F5F6F8",
      "surface": "#FFFFFF",
      "surfaceElevated": "#FFFFFF",
      "surfaceHover": "#EAEDF1",
      "border": "#DDE1E6",
      "borderSubtle": "#E8ECEF",
      "textPrimary": "#15171C",
      "textSecondary": "#555D68",
      "textMuted": "#636B78",
      "accent": "#C7CE32",
      "accentHover": "#B2B926",
      "accentSubtle": "rgba(199, 206, 50, 0.16)",
      "accentForeground": "#101208",
      "success": "#059669",
      "warning": "#B45309",
      "danger": "#DC2626",
      "info": "#2563EB"
    }
  },
  "accentPresets": {
    "electric-lime": {
      "labelEn": "1MS Electric Lime (Default)",
      "labelVi": "Vàng Chanh Điện 1MS (Mặc định)",
      "dark": "#FAFF69",
      "light": "#C7CE32",
      "foreground": "#101208"
    },
    "ice-cyan": {
      "labelEn": "Arctic Pulse",
      "labelVi": "Xanh Băng Bắc Cực",
      "dark": "#67E8F9",
      "light": "#0891B2",
      "foreground": "#081216"
    },
    "emerald-signal": {
      "labelEn": "Signal Mint",
      "labelVi": "Xanh Ngọc Tín Hiệu",
      "dark": "#6EE7B7",
      "light": "#059669",
      "foreground": "#06140F"
    },
    "warm-amber": {
      "labelEn": "Solar Amber",
      "labelVi": "Hổ Phách Ấm",
      "dark": "#FCD34D",
      "light": "#D97706",
      "foreground": "#140F04"
    }
  },
  "component": {
    "titlebar": {
      "height": "38px"
    },
    "navRail": {
      "collapsedWidth": "56px",
      "expandedWidth": "224px"
    },
    "inspector": {
      "defaultWidth": "340px",
      "minWidth": "280px",
      "maxWidth": "480px"
    }
  }
}
