    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px"
    },
    "radius": {
      "xs": "8px",
      "sm": "12px",
      "md": "14px",
      "lg": "18px",
      "xl": "24px",
      "card": "28px",
      "pill": "9999px"
    },
    "typography": {
      "fontFamily": {
        "brand": "'Manrope Variable', 'Manrope', 'Segoe UI', system-ui, -apple-system, sans-serif",
        "mono": "ui-monospace, 'Cascadia Mono', 'SFMono-Regular', 'Consolas', monospace"
      },
      "fontSize": {
        "xs": "11px",
        "sm": "12.5px",
        "compact": "13.5px",
        "base": "14.5px",
        "md": "16px",
        "lg": "21px",
        "xl": "28px",
        "2xl": "36px"
      },
      "lineHeight": {
        "heading": "1.2",
        "compact": "1.4",
        "body": "1.6"
      }
    },
    "motion": {
      "duration": {
        "instant": "90ms",
        "fast": "150ms",
        "normal": "240ms",
        "moderate": "360ms",
        "slow": "550ms"
      },
      "easing": {
        "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
        "spring": "cubic-bezier(0.34, 1.45, 0.64, 1)",
        "reveal": "cubic-bezier(0.22, 1, 0.36, 1)"
      }
    }
  },
