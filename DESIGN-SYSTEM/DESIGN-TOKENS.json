    "name": "1MS Studio Design System — Muse for Windows (1ms-studio.com Edition)",
    "standard": "1RS v1.2",
    "version": "1.0.0",
    "websiteReference": "https://1ms-studio.com/",
    "brandAccent": "#C7F34B",
    "brandFont": "Manrope",
    "iconSystem": "Lucide Icons",
    "uiComponentLibrary": "Lucian UX/UI (Seokwoooo/lucian-uxui)"
  },
  "primitive": {
