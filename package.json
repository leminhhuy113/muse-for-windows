{
  "name": "muse-for-windows",
  "version": "1.0.0",
  "description": "An independent open-source Windows desktop client for Muse, featuring native Windows integration, secure local tools and a premium 1MS Studio interface.",
  "author": {
    "name": "1MS Studio",
    "url": "https://github.com/leminhhuy113/muse-for-windows"
  },
  "license": "MIT",
  "homepage": "https://github.com/leminhhuy113/muse-for-windows#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leminhhuy113/muse-for-windows.git"
  },
  "bugs": {
    "url": "https://github.com/leminhhuy113/muse-for-windows/issues"
  },
  "keywords": [
    "muse",
    "muse-desktop",
    "muse-for-windows",
    "windows",
    "windows-11",
    "electron",
    "typescript",
    "react",
    "ai-assistant",
    "desktop-app",
    "computer-use",
    "local-agent",
    "open-source",
    "lucian-uxui",
    "1ms-studio"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.json\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.json\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets:generate": "node scripts/generate-assets.mjs",
    "security:scan": "node scripts/secret-scan.mjs",
    "release:metadata": "node scripts/generate-release-artifacts.mjs",
    "dist:win:x64": "node scripts/prepare-wincodesign.mjs && npm run build && electron-builder --win nsis portable --x64 --publish never",
    "dist:win:arm64": "node scripts/prepare-wincodesign.mjs && npm run build && electron-builder --win nsis portable --arm64 --publish never",
    "dist:win:all": "node scripts/prepare-wincodesign.mjs && npm run build && electron-builder --win nsis portable --x64 --arm64 --publish never"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/play": "5.2.5",
    "clsx": "2.1.1",
    "electron-updater": "6.6.2",
    "lucide-react": "0.511.0",
    "playwright-core": "1.52.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "3.3.0",
    "zod": "3.25.28",
    "zustand": "5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "9.27.0",
    "@playwright/test": "1.52.0",
    "@tailwindcss/vite": "4.1.7",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.21",
    "@types/react": "19.1.5",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.0",
    "electron": "36.3.2",
    "electron-builder": "26.0.12",
    "electron-vite": "3.1.0",
    "eslint": "9.27.0",
    "jsdom": "31.0.1",
    "pngjs": "7.0.0",
    "prettier": "3.5.3",
    "tailwindcss": "4.1.7",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.1",
    "vite": "6.3.5",
    "vitest": "3.1.4"
  }
}
