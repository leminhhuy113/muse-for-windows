# Dependencies & build outputs
node_modules/
dist/
out/
release/
build-temp/
coverage/
playwright-report/
test-results/

# Environment & secrets
.env
.env.*
!.env.example

# Logs & runtime databases
*.log
npm-debug.log*
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

