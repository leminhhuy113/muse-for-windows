# Muse for Windows — Environment Configuration Example
# Developed by 1MS Studio · Powered by 1RS v1.2
# Copy to .env for local development overrides only. Never commit secrets.

# Development diagnostics (set to 1 in local dev only)
MUSE_DEV_DIAGNOSTICS=0

# Optional override for official Muse web URL (defaults to https://muse.ai)
MUSE_OFFICIAL_URL=https://muse.ai

# Optional local Ollama base URL for Mode C Independent Local Agent (disabled by default)
MUSE_LOCAL_OLLAMA_URL=http://127.0.0.1:11434

# Optional Windows code signing (CI release workflow only — leave empty for unsigned open-source builds)
# CSC_LINK=
# CSC_KEY_PASSWORD=
